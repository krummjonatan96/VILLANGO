DB_HOST=tu-servidor-mysql
DB_PORT=3306
DB_NAME=tu-base-de-datos
DB_USER=tu-usuario
DB_PASSWORD=tu-contraseña
PORT=3000

# Supabase (claves de servidor: nunca las expongas en Flutter)
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave
SUPABASE_SECRET_KEY=sb_secret_tu_clave_secreta
SUPABASE_JWKS_URL=https://tu-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Tablas habilitadas en Supabase Realtime, separadas por comas.
SUPABASE_REALTIME_TABLES=conductor_ubicacion,viajes,solicitudes_viaje_conductor

